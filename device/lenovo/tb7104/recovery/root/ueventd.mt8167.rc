# Permissions for Block Devices (MediaTek SoC)
/dev/block/platform/soc/11120000.mmc/by-name/boot       0640    root    system
/dev/block/platform/soc/11120000.mmc/by-name/recovery   0640    root    system
/dev/block/platform/soc/11120000.mmc/by-name/seccfg     0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/proinfo    0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/nvram      0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/para       0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/logo       0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/fip        0660    root    system
/dev/block/platform/soc/11120000.mmc/by-name/odmdtbo    0660    root    system

# Secure Storage & Keys
/dev/block/platform/soc/11120000.mmc/by-name/kb         0660    root    dm_rpc
/dev/block/platform/soc/11120000.mmc/by-name/dkb        0660    root    dm_rpc
/dev/kb                                                  0660    root    dm_rpc
/dev/dkb                                                 0660    root    dm_rpc

# MTD Block Devices
/dev/mtd/mtd15                                           0660    root    dm_rpc
/dev/mtd/mtd16                                           0660    root    dm_rpc
/dev/block/mtdblock15                                    0660    root    dm_rpc
/dev/block/mtdblock16                                    0660    root    dm_rpc

# Connectivity (WLAN, BT, GPS, FM)
/dev/stpwmt                                              0660    system  system
/dev/wmtdetect                                           0660    system  system
/dev/stpbt                                               0660    bluetooth bluetooth
/dev/stpgps                                              0660    gps     gps
/dev/gps                                                 0660    gps     system
/dev/mt3337_gpsonly                                      0666    gps     system
/dev/wmtWifi                                             0660    wifi    wifi
/dev/fm                                                  0660    media   media

# NFC
/dev/msr3110                                             0666    root    root
/dev/mt6605                                              0660    nfc     radio

# MTK BTIF driver
/dev/btif                                                0600    system  system

# GPU / Graphics
/dev/dri/card0                                           0666    system  system
/dev/pvr_sync                                            0666    root    root

# MTK Inhouse TEE & Security
/dev/trustzone                                           0660    system  dm_rpc
/dev/pvrsrvkm                                            0666    root    root

# RPMB
/dev/block/mmcblk0rpmb                                   0660    root    system

# Hang Detect & Hardware Monitors
/dev/RT_Monitor                                          0600    system  system
/dev/kick_powerkey                                       0600    system  system

