# mount point   fstype  device                                                     flags
/boot           emmc    /dev/block/platform/soc/11120000.mmc/by-name/boot          flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/soc/11120000.mmc/by-name/recovery      flags=display="Recovery";backup=1;flashimg=1
/system         ext4    /dev/block/platform/soc/11120000.mmc/by-name/system        flags=display="System";backup=1
/vendor         ext4    /dev/block/platform/soc/11120000.mmc/by-name/vendor        flags=display="Vendor";backup=1
/cache          ext4    /dev/block/platform/soc/11120000.mmc/by-name/cache
/data           ext4    /dev/block/platform/soc/11120000.mmc/by-name/userdata      flags=encryptable=footer
/metadata       ext4    /dev/block/platform/soc/11120000.mmc/by-name/metadata      flags=display="Metadata"
/misc           emmc    /dev/block/platform/soc/11120000.mmc/by-name/para          flags=display="Misc";backup=1
/nvram          emmc    /dev/block/platform/soc/11120000.mmc/by-name/nvram         flags=display="Nvram";backup=1
/logo           emmc    /dev/block/platform/soc/11120000.mmc/by-name/logo          flags=display="Logo";backup=1;flashimg=1
/external_sd    vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1                 flags=display="MicroSD";storage;wipeui;removable
/usb_otg        vfat    /dev/block/sda1         /dev/block/sda                     flags=display="USB-OTG";storage;wipeui;removable

