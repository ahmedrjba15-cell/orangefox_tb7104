# mount point   fstype  device                                                     flags
/boot           emmc    /dev/block/platform/soc/11120000.mmc/by-name/boot
/recovery       emmc    /dev/block/platform/soc/11120000.mmc/by-name/recovery
/system         ext4    /dev/block/platform/soc/11120000.mmc/by-name/system
/vendor         ext4    /dev/block/platform/soc/11120000.mmc/by-name/vendor
/cache          ext4    /dev/block/platform/soc/11120000.mmc/by-name/cache
/data           ext4    /dev/block/platform/soc/11120000.mmc/by-name/userdata
/metadata       ext4    /dev/block/platform/soc/11120000.mmc/by-name/metadata
/misc           emmc    /dev/block/platform/soc/11120000.mmc/by-name/para
/nvram          emmc    /dev/block/platform/soc/11120000.mmc/by-name/nvram
/logo           emmc    /dev/block/platform/soc/11120000.mmc/by-name/logo
/external_sd    vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1
/usb_otg        vfat    /dev/block/sda1         /dev/block/sda
